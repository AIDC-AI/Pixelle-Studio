# ============================================================
# Pixelle-Studio Environment Configuration
# Copy this file to .env and fill in your values
#   cp .env.example .env
# ============================================================

# ========================
# LLM / OpenAI Configuration (Optional)
# Recommended: configure API Key via the Settings (⚙️) page in the UI.
# These env vars serve as system-level defaults / fallbacks.
# ========================
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Backup API Key (for Auth Failover, optional)
# When the primary key hits rate limits or quota, the system auto-switches to the backup
# OPENAI_API_KEY_BACKUP=sk-your-backup-key-here

# ========================
# Model Failover Configuration
# ========================
# Enable model failover (when primary model fails, auto-switch to fallback models)
ENABLE_MODEL_FAILOVER=true

# Fallback model chain (comma-separated, tried in order)
# MODEL_FALLBACKS=gpt-4o-mini,gpt-4-turbo,gpt-3.5-turbo

# Enable thinking level failover (downgrade thinking depth on failure)
ENABLE_THINKING_FAILOVER=true

# Enable auth failover (switch API Key / Base URL on failure)
ENABLE_AUTH_FAILOVER=true

# ========================
# Service Ports
# ========================
FRONTEND_PORT=3000
BACKEND_PORT=8001

# ========================
# Frontend -> Backend Connection
# For Docker Compose deployment, use the host machine address
# For local development, use http://localhost:8001
# ========================
NEXT_PUBLIC_API_BASE=http://localhost:8001/api
NEXT_PUBLIC_WS_BASE=ws://localhost:8001/ws

# ========================
# Backend Configuration (Optional)
# ========================

# JWT Secret - CHANGE THIS in production!
JWT_SECRET=your-jwt-secret-change-in-production

# LLM Settings
LLM_TIMEOUT=300
LLM_MAX_TOKENS=16384

# Agent Settings
AGENT_MAX_TURNS=50
DEFAULT_THINKING_LEVEL=medium

# Context Management
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_KEEP_RECENT=10
CONTEXT_MIN_MESSAGES_BEFORE_COMPACT=15

# Network Configuration
# Set this to your server's public IP/domain for file URL generation
# EXTERNAL_IP=your-server-ip

# Proxy Settings (if needed)
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port
