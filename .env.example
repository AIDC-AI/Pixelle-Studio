# ============================================================
# Pixelle-Studio Environment Configuration (Optional)
#
# For most users, NO .env file is needed!
# All LLM settings (API Key, Base URL, Model) are configured
# through the web UI: click ⚙️ Settings in the top-right corner.
#
# This file is only needed for:
#   - Docker Compose deployment on non-localhost environments
#   - Production deployment (JWT_SECRET)
#   - Custom port or proxy configuration
#
# Usage:
#   cp .env.example .env    # Docker Compose reads from project root
# ============================================================

# ========================
# Service Ports
# ========================
FRONTEND_PORT=3000
BACKEND_PORT=8001

# ========================
# Frontend -> Backend Connection
# Only change these if deploying to a remote server or custom ports.
# For local development, the defaults work out of the box.
# ========================
NEXT_PUBLIC_API_BASE=http://localhost:8001/api
NEXT_PUBLIC_WS_BASE=ws://localhost:8001/ws

# ========================
# Security
# ========================
# JWT Secret - CHANGE THIS in production! Leave empty to use built-in dev default.
# JWT_SECRET=your-random-secret-string-here

# ========================
# Advanced Backend Defaults (Optional)
# These are system-level defaults. Users can override them per-account
# in the web UI Settings panel.
# ========================

# LLM request timeout (seconds) and max output tokens
# LLM_TIMEOUT=300
# LLM_MAX_TOKENS=16384

# Agent max turns per conversation
# AGENT_MAX_TURNS=50

# Default thinking level: high / medium / low / off
# DEFAULT_THINKING_LEVEL=medium

# Context auto-compaction settings
# CONTEXT_COMPACTION_ENABLED=true
# CONTEXT_KEEP_RECENT=10
# CONTEXT_MIN_MESSAGES_BEFORE_COMPACT=15

# Failover switches (all enabled by default)
# ENABLE_MODEL_FAILOVER=true
# ENABLE_THINKING_FAILOVER=true
# ENABLE_AUTH_FAILOVER=true

# ========================
# Network (Optional)
# ========================
# Public IP/domain for generated file URLs (only needed for remote deployment)
# EXTERNAL_IP=your-server-ip

# Proxy settings (if behind a corporate proxy)
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port
