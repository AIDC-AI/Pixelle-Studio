{
  "description": "Example of Auth profiles- Support multiple API keys for error transfer.",
  "auth_profiles": [
    {
      "id": "openai-primary",
      "provider": "openai",
      "api_key": "sk-your-primary-key-here",
      "base_url": null
    },
    {
      "id": "openai-backup",
      "provider": "openai",
      "api_key": "sk-your-backup-key-here",
      "base_url": null
    },
    {
      "id": "openai-custom-endpoint",
      "provider": "openai",
      "api_key": "sk-your-custom-key-here",
      "base_url": "https://your-custom-endpoint.com/v1"
    }
  ],
  "notes": [
    "Copy this file as auth_profiles.json and fill in real API Keys",
    "The system will try each configuration in order",
    "Failed configurations enter a cooldown period (exponential backoff)",
    "If no config file exists, the system reads OPENAI_API_KEY from environment variables"
  ]
}

