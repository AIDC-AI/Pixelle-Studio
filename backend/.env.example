# ===== LLM 配置 =====
# OpenAI 兼容的 API Base URL
OPENAI_BASE_URL=https://api.openai.com/v1

# 主 API Key
OPENAI_API_KEY=sk-your-api-key-here
# 备用 API Key (可选)
OPENAI_API_KEY_BACKUP=sk-your-backup-key-here

# 主模型
OPENAI_MODEL=gpt-4o
# 降级备用模型 (逗号分隔)
MODEL_FALLBACKS=gpt-4o-mini,gpt-3.5-turbo

# 外部可访问 IP (可选，默认自动检测)
# EXTERNAL_IP=127.0.0.1

# ===== 故障转移开关 =====
# 启用认证故障转移
ENABLE_AUTH_FAILOVER=true

# 启用模型故障转移
ENABLE_MODEL_FAILOVER=true

# 启用 Thinking Level 降级
ENABLE_THINKING_FAILOVER=true

# 默认 Thinking Level (high, medium, low, off)
DEFAULT_THINKING_LEVEL=medium

# ===== 上下文管理 =====
# 启用自动上下文压缩
CONTEXT_COMPACTION_ENABLED=true

# 压缩时保留最近几条消息
CONTEXT_KEEP_RECENT=10

# 最少消息数才考虑压缩
CONTEXT_MIN_MESSAGES_BEFORE_COMPACT=15
